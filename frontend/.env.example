# ─── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL — found in: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — found in: Project Settings → API → anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key (SECRET — NEVER expose to browser)
# Found in: Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── App ─────────────────────────────────────────────────────────────────────
# The public URL of your deployed site (used for password-reset redirect links)
# e.g. https://your-app.vercel.app  OR  http://localhost:3000 for local dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL for API calls.  Leave as /api when frontend and API are on the same domain.
# Change to your full API URL only if you deploy them separately.
NEXT_PUBLIC_API_URL=/api

# ─── Optional features ───────────────────────────────────────────────────────
# Set to "true" to show the Google OAuth button on the login page
NEXT_PUBLIC_GOOGLE_ENABLED=false

# ─── Email (optional — verification codes & reset emails) ─────────────
# Get a free key at https://resend.com
# RESEND_API_KEY=re_your_key_here
# FROM_EMAIL=Amazon Admin <noreply@amazonstore.com>

# ─── Demo credentials (created by: npm run seed) ─────────────────────────────
# Run "npm run seed" once with the same Supabase keys above to create these users.
#
#   Super Admin  superadmin@amazonstore.com / Super@123456
#   Admin        admin@amazonstore.com      / Admin@123456
#   Customer     customer@amazonstore.com   / Customer@123456
